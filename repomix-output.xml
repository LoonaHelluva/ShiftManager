            }
            if (taskCheck.Executor.Count == 0)
            {
                return Results.BadRequest("Executors ammount less than 1");
            }

            return await next(context);
        });

        //PUT
        tasks.MapPut("/{id}", async (int id, UpdateTaskDto updatedTask, ITaskDbService dbService) =>
        {
            try
            {
